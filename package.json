{
  "name": "shanhe-poetry-room",
  "private": true,
  "version": "1.3.0",
  "description": "毛主席诗词 · 山河诗卷，一座纸本风格的数字阅览室",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build": "node scripts/build-data.mjs && vite build",
    "dev": "node scripts/build-data.mjs && vite --host 127.0.0.1 --port 7065 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 7065 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --experimental-test-coverage --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "verify:production": "node scripts/verify-production.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:fullscreen": "node tests/fullscreen.mjs",
    "test:worker": "node tests/worker-integration.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "vite": "^8.3.6",
    "wrangler": "4.156.0"
  }
}
