{
  "name": "shanhe-poetry-room",
  "private": true,
  "version": "1.0.0",
  "description": "毛主席诗词 · 山河诗卷，一座纸本风格的数字阅览室",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build": "node scripts/build-data.mjs && vite build",
    "dev": "node scripts/build-data.mjs && vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:fullscreen": "node tests/fullscreen.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "vite": "^8.3.6"
  }
}
