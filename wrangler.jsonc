{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mao",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"],
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "mao.hexly.ai", "custom_domain": true }
  ]
}
